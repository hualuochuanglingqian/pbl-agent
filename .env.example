# ===== 对话模型供应商（默认智谱；可换 deepseek / openai / custom）=====
PBL_PROVIDER=zhipu
# PBL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# PBL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# PBL_PROVIDER=custom                 # 任意 OpenAI 兼容端点
# PBL_API_KEY=sk-...
# PBL_BASE_URL=https://...

# 对话模型名（各供应商缺省：glm-4-flash / deepseek-chat / gpt-4o-mini）
PBL_MODEL=glm-4-flash

# ===== 教材 RAG 向量化（固定使用智谱，需保留此 Key）=====
ZHIPUAI_API_KEY=你的智谱APIKey
PBL_EMBED_MODEL=embedding-3

# 其他
PBL_TEMPERATURE=0.6
# PBL_TRUST_ENV=0                    # openai/custom 端点也强制直连（默认国外端点走系统代理）
